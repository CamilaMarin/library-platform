{
  "enabled": true,
  "name": "Documentation Synchronizer",
  "description": "When the agent stops working (task complete), verify that all affected documentation has been updated: specifications, ADR references, IMPLEMENTATION_STATUS.md, CHANGELOG.md, README progress, architecture diagrams, and open risks. Report any inconsistencies.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before finalizing, check documentation synchronization: (1) Are affected specifications still consistent with the implementation? (2) Is IMPLEMENTATION_STATUS.md updated with current progress? (3) Is CHANGELOG.md updated if user-visible behavior changed? (4) Are ADR references correct? (5) Are architecture diagrams current? Report any gaps that need to be addressed before the work can be considered complete."
  }
}
